<%
  recipes_active = request.path.start_with?(recipes_path) || request.path == '/'
  meal_plans_active = request.path.start_with?(meal_plans_path)
  shopping_active = request.path.start_with?(shopping_lists_path)
%>
<div class="footer-nav">
  <nav class="footer-nav__segmented">
    <%= link_to "Recipes", recipes_path, class: "footer-nav__item #{'footer-nav__item--active' if recipes_active}" %>
    <%= link_to "Plans", meal_plans_path, class: "footer-nav__item #{'footer-nav__item--active' if meal_plans_active}" %>
    <%= link_to "Shopping", shopping_lists_path, class: "footer-nav__item #{'footer-nav__item--active' if shopping_active}" %>
  </nav>
</div>