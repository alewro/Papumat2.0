<% content_for :title, "Recipes" %>
<div class="container mt-3">
  <p class="ps-4 fs-3 fw-bolder text-start w-100">Recipes</p>
  <div class="container mt-3 mb-5 pb-5">
    <% @recipe_categories.each do |category| %>
      <%= render "meal_plan_category_header", category: category %>
      <%= render 'recipes/recipes', id: category.id %>
    <% end %>
  </div>
</div><%= link_to "", new_recipe_path, class: "fab fab-primary bi bi-plus-lg", title: "New recipe" %>
