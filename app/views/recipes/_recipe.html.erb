<div id="<%= dom_id recipe %>" class="container mt-3 pb-5">
  <div class="row">
  <div class="col-8">
  <h3><%= recipe.name %></h3>
  </div>
  <div class="btn-group col-4">
    <%= link_to "", edit_recipe_path(@recipe), class:"btn bi bi-pencil" %>
    <%= button_to "", @recipe, method: :delete, data: {turbo_confirm: "Are you sure you want to delete #{recipe.name} recipe?"}, class:"btn bi bi-trash" %>
  </div>

  </div>
  <%= render "mini_meal_plan_category_header", category: recipe.recipe_category %>
  
  <p class="mb-5"><%= simple_format(recipe.description) %></p>

  <h6 class="text-start">Products</h6>
  <% recipe.products.each_with_index do |product, index| %>
    <div class="row d-flex justify-content-between">
      <div class="col-8 border-end ps-3 p-1<%= " border-bottom" if index < recipe.products.size - 1 %>"><%= product.name %></div>
      <div class="col-4 p-1 text-center<%= " border-bottom" if index < recipe.products.size - 1 %>">
        <% if product.quantity % 1 == 0 %>
          <%= product.quantity.to_i%>
        <% else %>
          <%= product.quantity%>
        <% end %>
      </div>
    </div>
  <% end %>

</div>
