<% content_for :title, "Papumat 2.0" %>
<div class="container min-vh-100 d-flex align-items-center py-4 py-md-5">
  <div class="row justify-content-center">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5">
      <div class="border-0 rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
          <h2 class="h3 fw-semibold mb-4 text-center">Papumat</h2>

          <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login-form" }) do |f| %>

            <div class="field mb-4">
              <%= f.email_field :email, autofocus: true, autocomplete: "email", inputmode: "email", class: "form-control form-control-lg py-3", placeholder: "Email", required: true %>
            </div>

            <div class="field mb-4">
              <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-lg py-3", placeholder: "Password", required: true %>
            </div>

            <% if devise_mapping.rememberable? %>
              <div class="field mb-4 d-none">
                <div class="form-check form-check-lg">
                  <%= f.check_box :remember_me, class: "form-check-input", checked: true %>
                  <%= f.label :remember_me, class: "form-check-label" %>
                </div>
              </div>
            <% end %>

            <div class="actions d-grid gap-2 mb-4">
              <%= f.submit "Log in", class: "btn btn-dark btn-lg py-3 fw-semibold rounded-3" %>
            </div>
          <% end %>

          <div class="text-center">
            <%= render "devise/shared/links" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>