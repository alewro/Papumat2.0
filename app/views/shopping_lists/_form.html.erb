<div class="shopping-list-form">
  <%= form_with(model: shopping_list) do |form| %>
    <div>
      <%= form.hidden_field :is_bought, value: false %>
    </div>
    <div>
      <%= form.hidden_field :product_category_id, value: 1 %>
    </div>
      <div>
      <%= form.hidden_field :order_hint, value: 0 %>
    </div>

    <div class="d-flex align-items-stretch gap-2">
      <div class="input-group flex-grow-1">
        <%= form.text_field :product_name, autocomplete: 'off', placeholder:"Product name", style:"flex: 5", class:"form-control rounded-start-pill" %>
        <%= form.select :product_quantity, options_for_select((-10..10).to_a, 1), {}, style:"flex: 1", class:"form-select rounded-end-pill" %>
      </div>
      <%= form.submit "+", class:"shopping-list-form__submit align-self-center" %>
    </div>
  <% end %>
</div>
